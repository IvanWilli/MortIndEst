dplyr::mutate(d = (1-alpha) * d, triangle = "l", yb = y - x)
deaths_upper <- deaths %>%
dplyr::mutate(d = alpha * d, triangle = "u", yb = y - x - 1)
deaths <- dplyr::bind_rows(
